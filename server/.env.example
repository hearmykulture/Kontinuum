# --- Server ---
PORT=4000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://<USER>:<PASSWORD>@127.0.0.1:5432/kontinuum?schema=public&sslmode=disable

# --- Plaid ---
PLAID_ENV=sandbox
PLAID_CLIENT_ID=<YOUR_CLIENT_ID>
PLAID_SECRET=<YOUR_SECRET>
PLAID_REDIRECT_URI=

# --- Crypto (exactly 32 ASCII chars or base64 for 32 bytes) ---
ENCRYPTION_KEY=<32_CHAR_KEY>
