# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/kontinuum?schema=public&sslmode=disable
SHADOW_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/kontinuum_shadow?sslmode=disable

# --- Plaid (Sandbox) ---
PLAID_ENV=sandbox
PLAID_CLIENT_ID=68f50eec7c634d00204cc057
PLAID_SECRET=9b5f5f23ebaefb9aa330e96c990924

# ✅ Redirect URI must EXACTLY match what’s in Plaid Dashboard
PLAID_REDIRECT_URI=https://honest-needed-beauty-counseling.trycloudflare.com/plaid/oauth

# (Optional info; your code uses PUBLIC_BASE_URL to derive the webhook)
PLAID_WEBHOOK_URL=https://honest-needed-beauty-counseling.trycloudflare.com/plaid/webhook

# --- Server ---
PORT=4001
PUBLIC_BASE_URL=https://honest-needed-beauty-counseling.trycloudflare.com
LOG_LEVEL=info
NODE_ENV=development

# --- Crypto (>=32 chars) ---
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- Catch-up Sync (daily cron; opt-in) ---
ENABLE_CATCHUP_CRON=true
CATCHUP_CRON_HOUR_UTC=09
CATCHUP_MAX_AGE_HOURS=24
CATCHUP_CONCURRENCY=3

# --- Mobile app identifiers (optional for OAuth banks) ---
ANDROID_PACKAGE_NAME=com.example.kontinuum
IOS_BUNDLE_ID=com.example.kontinuum
